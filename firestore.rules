rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membersOf(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }
    function memberOf(coupleId) { return signedIn() && request.auth.uid in membersOf(coupleId); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      // You can always read your own profile; you can read your partner's (gender) once you
      // are both members of the couple named in their profile. Membership is decided by the
      // couple document, so nobody can read a stranger's profile by editing their own coupleId.
      allow read: if signedIn() && (
        request.auth.uid == userId || (
          resource.data.get('coupleId', null) is string &&
          request.auth.uid in membersOf(resource.data.coupleId) &&
          userId in membersOf(resource.data.coupleId)
        )
      );
      allow create, update: if signedIn() && request.auth.uid == userId
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['girl', 'boy']);
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid;

      // A couple with one member is open to whoever holds its code (that is how joining works).
      allow get: if signedIn() && (request.auth.uid in resource.data.members || resource.data.members.size() == 1);

      allow update: if signedIn() && (
        // Members can change anything except who is in the couple.
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy) ||
        // A second person joins: only `members` changes, the first member stays, joiner is last.
        (resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && resource.data.members[0] == request.resource.data.members[0]
          && request.resource.data.members[1] == request.auth.uid
          && onlyChanges(['members']))
      );

      match /messages/{messageId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId)
          && request.resource.data.keys().hasOnly(['type', 'text', 'authorId', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type in ['chat', 'poke', 'note']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        // Reactions are the only thing that can change on a message.
        allow update: if memberOf(coupleId) && onlyChanges(['reactions']);
      }

      // Snaps are one-time photos. The snap record is small; the photo itself lives in snapImages.
      match /snaps/{snapId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId)
          && request.resource.data.keys().hasOnly(['authorId', 'caption', 'viewed', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.viewed == false
          && request.resource.data.createdAt == request.time;
        // The receiver marks a snap as viewed.
        allow update: if memberOf(coupleId)
          && resource.data.authorId != request.auth.uid
          && onlyChanges(['viewed']);
        // Either of you can delete a snap (the receiver does it after closing it, the sender can unsend).
        allow delete: if memberOf(coupleId);
      }

      // The receiver can only read a photo after its snap has been marked as viewed.
      match /snapImages/{snapId} {
        allow read: if memberOf(coupleId) && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/couples/$(coupleId)/snaps/$(snapId)).data.viewed == true
        );
        allow create: if memberOf(coupleId)
          && request.resource.data.keys().hasOnly(['authorId', 'data', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 800000
          && request.resource.data.createdAt == request.time;
        allow delete: if memberOf(coupleId);
      }

      // Each person's photo for the couple portrait. You manage only your own; both of you can see them.
      match /photos/{photoId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId) && photoId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'data', 'aiOk', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 600000
          && request.resource.data.aiOk is bool
          && request.resource.data.createdAt == request.time;
        allow update: if memberOf(coupleId) && photoId == request.auth.uid && (
          // Changing only the "AI may use my photo" choice…
          (onlyChanges(['aiOk']) && request.resource.data.aiOk is bool) ||
          // …or replacing the whole photo.
          (request.resource.data.keys().hasOnly(['authorId', 'data', 'aiOk', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.data is string
            && request.resource.data.data.size() < 600000
            && request.resource.data.aiOk is bool
            && request.resource.data.createdAt == request.time)
        );
        allow delete: if memberOf(coupleId) && photoId == request.auth.uid;
      }

      // Phones that have notifications turned on. Both of you can read them (that is how a push finds your
      // partner's phone); each person manages only their own devices, whose ids start with their uid.
      match /push/{deviceId} {
        allow read: if memberOf(coupleId);
        allow create, update: if memberOf(coupleId)
          && deviceId.matches(request.auth.uid + '_[A-Za-z0-9]{8,64}')
          && request.resource.data.keys().hasOnly(['uid', 'endpoint', 'p256dh', 'auth', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('https://.*')
          && request.resource.data.endpoint.size() < 600
          && request.resource.data.p256dh is string
          && request.resource.data.p256dh.size() < 200
          && request.resource.data.auth is string
          && request.resource.data.auth.size() < 100
          && request.resource.data.createdAt == request.time;
        allow delete: if memberOf(coupleId) && deviceId.matches(request.auth.uid + '_[A-Za-z0-9]{8,64}');
      }

      // The AI-drawn couple portrait shown on the home screen (the collage needs no document).
      match /portraits/{portraitId} {
        allow read: if memberOf(coupleId);
        allow create, update: if memberOf(coupleId)
          && request.resource.data.keys().hasOnly(['data', 'kind', 'by', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind == 'ai'
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.createdAt == request.time;
        allow delete: if memberOf(coupleId);
      }

      // The cycle tracker is off for everyone until a person turns it on. Each person's cycle is their own document,
      // couples/{id}/cycle/{their uid}: only they can write it. Their partner can read it only while it is both switched on
      // and shared, so turning sharing off really hides it (it is not just hidden on screen).
      match /cycle/{ownerId} {
        function validCycle() {
          let d = request.resource.data;
          return d.keys().hasOnly(['on', 'share', 'cycleLength', 'periodLength', 'periods', 'log', 'updatedAt'])
            && d.on is bool && d.share is bool
            && d.cycleLength is int && d.cycleLength >= 15 && d.cycleLength <= 60
            && d.periodLength is int && d.periodLength >= 1 && d.periodLength <= 14
            && d.periods is list && d.periods.size() <= 60
            && d.log is map && d.log.size() <= 800
            && d.updatedAt == request.time;
        }
        allow read: if memberOf(coupleId)
          && (ownerId == request.auth.uid || resource == null || (resource.data.on == true && resource.data.share == true));
        allow create, update: if memberOf(coupleId) && ownerId == request.auth.uid && validCycle();
        allow delete: if memberOf(coupleId) && ownerId == request.auth.uid;
      }
    }
  }
}
